<nav class="mc-nav">
    <a class="mc-nav__brand" href="/">
        <span class="mc-nav__brandMark">M</span>
        <span class="mc-nav__brandText">MobiCart</span>
    </a>
    <ul class="mc-nav__links">
        <li><a href="/">Home</a></li>
        <li>
            <a href="#">Brands <i class="fas fa-caret-down"></i></a>
            <ul class="dropdown">
                <li><a href="/cart/samsung">samsung</a></li>
                <li><a href="/cart/oppo">oppo</a></li>
                <li><a href="/cart/realme">realme</a></li>
                <li><a href="/cart/vivo">vivo</a></li>
                <li><a href="/cart/iphone">iphone</a></li>
                <li><a href="/cart/oneplus">oneplus</a></li>
            </ul>
        </li>
        <li><a href="/cart/compare">Compare</a></li>
        <li><a href="/cart/aboutus">Contact Us</a></li>
    </ul>
    <div class="mc-nav__actions">
        <a class="mc-nav__cart" href="/cart/show" aria-label="Cart">
            <i class="fa-solid fa-cart-shopping fa fa-shopping-cart"></i>
            <% if (locals.user) { %>
                <% if (cart==null || cart.items.length==0) { %>
                    <span class="mc-badge">0</span>
                <% } else { %>
                    <% let totalQty=0; for(let i=0; i < cart.items.length; i++){ let product=cart.items[i]; totalQty+=product.qty; } %>
                    <span class="mc-badge"><%= totalQty %></span>
                <% } %>
            <% } %>
        </a>

        <% if (locals.user) { %>
            <a class="mc-nav__user" href="/users/profile">
                <i class="fa-solid fa-user fa fa-user"></i>
                <span class="mc-nav__userName"><%= user.name %></span>
            </a>
            <a class="mc-btn mc-nav__auth" href="/users/wishlist">
                <i class="fa-regular fa-heart fa fa-heart"></i>&nbsp;Wishlist
            </a>
        <% } else { %>
            <a class="mc-btn mc-btn--primary mc-nav__auth" href="/users/sign-in">Sign in</a>
            <a class="mc-btn mc-nav__auth" href="/users/sign-up" target="_blank">Create account</a>
        <% } %>
        <button class="mc-nav__toggle menu-btn" type="button" aria-label="Menu">
            <i class="fa-solid fa-bars fa fa-bars"></i>
        </button>
    </div>
</nav>
