
<head>
    <title><%=title%></title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
        crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/profile.css">
    <link rel="stylesheet" href="/nav.css">
    <link rel="stylesheet" href="/theme.css">
    <script src="https://kit.fontawesome.com/878d22e054.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="navigate">
        <%- include('_nav'); %>
      </div>
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="profile-links">
                    <img src="<%=user.avatar%>" alt="">
                    <h2><i class="fa-solid fa-user fa-xs"></i> <%=user.name%></h2><br>
                    <li class="neon"><a href="/users/sign-out">Sign Out</a></li>
                    <li class="neon"><a href="/users/editpro/<%=user._id%>">Edit Profile</a></li>
                    <li class="neon"><a href="/order/myorder">My Orders</a></li>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mt-custum">
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                User Name
                            </div>
                            <div class="col-4">
                                <%=user.name%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Full Name
                            </div>
                            <div class="col-4">
                                <%=user.fullName%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Email
                            </div>
                            <div class="col-4">
                                <%=user.email%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Gender
                            </div>
                            <div class="col-4">
                                <%=user.gender%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Date Of Birth
                            </div>
                            <div class="col-4">
                                <%=user.dateOfBirth.toLocaleString('en-US', { dateStyle: 'medium'})%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Contact Number
                            </div>
                            <div class="col-4">
                                <%=user.phoneNumber%>
                            </div>
                        </div>
                    </div>
                    <div class="details">
                        <div class="row">
                            <div class="col-8">
                                Address
                            </div>
                            <div class="col-4">
                                <%=user.address%>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    <script src="/first.js"></script>
</body>
</html>
